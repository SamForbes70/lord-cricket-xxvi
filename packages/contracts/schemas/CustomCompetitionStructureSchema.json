{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "ROUND_ROBIN"
        },
        "legs": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            }
          ]
        },
        "finalTopTwo": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "legs",
        "finalTopTwo"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "GROUPS_KNOCKOUT"
        },
        "groups": {
          "type": "array",
          "prefixItems": [
            {
              "minItems": 3,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              }
            },
            {
              "minItems": 3,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              }
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": false
        }
      },
      "required": [
        "kind",
        "groups"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "SERIES"
        },
        "matches": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 3
            },
            {
              "type": "number",
              "const": 5
            },
            {
              "type": "number",
              "const": 7
            }
          ]
        }
      },
      "required": [
        "kind",
        "matches"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "urn:lcxxvi:CustomCompetitionStructure:1",
  "title": "CustomCompetitionStructure"
}
