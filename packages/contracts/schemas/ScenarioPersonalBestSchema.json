{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scenarioId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "challengeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "completions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failures": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bestMarginType": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "RUNS",
            "WICKETS",
            "INNINGS"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "bestMarginValue": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "lastOutcome": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "COMPLETED",
            "FAILED"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "scenarioId",
    "challengeSha256",
    "attempts",
    "completions",
    "failures",
    "bestMarginType",
    "bestMarginValue",
    "lastOutcome"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:ScenarioPersonalBest:1",
  "title": "ScenarioPersonalBest"
}
