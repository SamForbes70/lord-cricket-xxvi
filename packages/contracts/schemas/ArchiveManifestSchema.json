{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "gameId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "versions": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "1.0.0"
        },
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "random": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "rules": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "rulesHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "modelHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "worldHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema",
        "engine",
        "random",
        "rules",
        "rulesHash",
        "model",
        "modelHash",
        "worldHash"
      ],
      "additionalProperties": false
    },
    "entries": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))(?!.*\\\\)[A-Za-z0-9_./-]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "gameId",
    "versions",
    "entries"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:ArchiveManifest:1",
  "title": "ArchiveManifest"
}
