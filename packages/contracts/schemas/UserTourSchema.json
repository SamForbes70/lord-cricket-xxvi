{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tourId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "format": {
      "type": "string",
      "enum": [
        "T20",
        "ODI"
      ]
    },
    "hostTeamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "touringName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "matches": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 3
        },
        {
          "type": "number",
          "const": 5
        },
        {
          "type": "number",
          "const": 7
        }
      ]
    },
    "groundIds": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    }
  },
  "required": [
    "tourId",
    "title",
    "format",
    "hostTeamId",
    "touringName",
    "matches",
    "groundIds"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:UserTour:1",
  "title": "UserTour"
}
