{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "eventHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inningsIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "deliveryIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "overBallLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "strikerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "strikerName": {
      "type": "string",
      "pattern": "^[\\s\\S]{1,80}$"
    },
    "strikerHand": {
      "type": "string",
      "enum": [
        "R",
        "L"
      ]
    },
    "bowlerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "bowlerName": {
      "type": "string",
      "pattern": "^[\\s\\S]{1,80}$"
    },
    "momentKind": {
      "type": "string",
      "enum": [
        "WICKET",
        "SIX",
        "FOUR",
        "FREE_HIT",
        "EXTRA",
        "RUNS",
        "DOT"
      ]
    },
    "isKeyMoment": {
      "type": "boolean"
    },
    "runsScored": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "batRuns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "boundary": {
      "type": "string",
      "enum": [
        "NONE",
        "FOUR",
        "SIX"
      ]
    },
    "legality": {
      "type": "string",
      "enum": [
        "LEGAL",
        "WIDE",
        "NO_BALL",
        "DEAD"
      ]
    },
    "dismissalKind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "BOWLED",
            "LBW",
            "CAUGHT",
            "RUN_OUT",
            "STUMPED",
            "HIT_WICKET"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "dismissedPlayerName": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[\\s\\S]{1,80}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fieldOutcome": {
      "type": "string",
      "enum": [
        "NONE",
        "STOP",
        "DROP",
        "CATCH",
        "MISS",
        "RUN_OUT"
      ]
    },
    "executedLength": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "YORKER",
            "FULL",
            "GOOD",
            "SHORT",
            "FULL_TOSS"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "trajectory": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "GROUND",
            "AERIAL",
            "EDGE"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "recordedSector": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        {
          "type": "null"
        }
      ]
    },
    "displaySector": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        {
          "type": "null"
        }
      ]
    },
    "sectorStatus": {
      "type": "string",
      "enum": [
        "RECORDED_SECTOR",
        "PITCH_CHANNEL_ONLY"
      ]
    },
    "releasePoint": {
      "type": "object",
      "properties": {
        "x10": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "y10": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        }
      },
      "required": [
        "x10",
        "y10"
      ],
      "additionalProperties": false
    },
    "pitchBouncePoint": {
      "type": "object",
      "properties": {
        "x10": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "y10": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        }
      },
      "required": [
        "x10",
        "y10"
      ],
      "additionalProperties": false
    },
    "strikerCreasePoint": {
      "type": "object",
      "properties": {
        "x10": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "y10": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        }
      },
      "required": [
        "x10",
        "y10"
      ],
      "additionalProperties": false
    },
    "targetPoint": {
      "type": "object",
      "properties": {
        "x10": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "y10": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        }
      },
      "required": [
        "x10",
        "y10"
      ],
      "additionalProperties": false
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "detailText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "trackingDisclaimer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    }
  },
  "required": [
    "sequence",
    "eventHash",
    "inningsIndex",
    "deliveryIndex",
    "overBallLabel",
    "strikerId",
    "strikerName",
    "strikerHand",
    "bowlerId",
    "bowlerName",
    "momentKind",
    "isKeyMoment",
    "runsScored",
    "batRuns",
    "boundary",
    "legality",
    "dismissalKind",
    "dismissedPlayerName",
    "fieldOutcome",
    "executedLength",
    "trajectory",
    "recordedSector",
    "displaySector",
    "sectorStatus",
    "releasePoint",
    "pitchBouncePoint",
    "strikerCreasePoint",
    "targetPoint",
    "headline",
    "detailText",
    "trackingDisclaimer"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:DeliveryHighlightCue:1",
  "title": "DeliveryHighlightCue"
}
