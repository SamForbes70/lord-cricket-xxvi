{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "LC_CUSTOM_COMPETITION_PACK_V1"
    },
    "packId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "competitions": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "competitionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "format": {
            "type": "string",
            "enum": [
              "T20",
              "ODI"
            ]
          },
          "sourceType": {
            "type": "string",
            "const": "FICTIONAL_CURATED"
          },
          "worldPackId": {
            "type": "string",
            "const": "fictional-eight-01"
          },
          "teamIds": {
            "minItems": 2,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "groundIds": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "structure": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "ROUND_ROBIN"
                  },
                  "legs": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 1
                      },
                      {
                        "type": "number",
                        "const": 2
                      }
                    ]
                  },
                  "finalTopTwo": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "legs",
                  "finalTopTwo"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "GROUPS_KNOCKOUT"
                  },
                  "groups": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "minItems": 3,
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                        }
                      },
                      {
                        "minItems": 3,
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                        }
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2,
                    "items": false
                  }
                },
                "required": [
                  "kind",
                  "groups"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "SERIES"
                  },
                  "matches": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 1
                      },
                      {
                        "type": "number",
                        "const": 3
                      },
                      {
                        "type": "number",
                        "const": 5
                      },
                      {
                        "type": "number",
                        "const": 7
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "matches"
                ],
                "additionalProperties": false
              }
            ]
          },
          "points": {
            "type": "object",
            "properties": {
              "win": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "tie": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "loss": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              }
            },
            "required": [
              "win",
              "tie",
              "loss"
            ],
            "additionalProperties": false
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          }
        },
        "required": [
          "competitionId",
          "title",
          "format",
          "sourceType",
          "worldPackId",
          "teamIds",
          "groundIds",
          "structure",
          "points",
          "summary"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaId",
    "packId",
    "competitions"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:CustomCompetitionPack:1",
  "title": "CustomCompetitionPack"
}
