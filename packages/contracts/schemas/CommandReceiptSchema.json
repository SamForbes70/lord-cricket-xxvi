{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "committedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventRange": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "first": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "last": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "first",
            "last"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "commandId",
    "committedRevision",
    "eventRange"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:CommandReceipt:1",
  "title": "CommandReceipt"
}
