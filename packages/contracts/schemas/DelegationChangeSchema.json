{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "matchRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "teamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "categories": {
      "uniqueItems": true,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "TOSS",
          "INNINGS",
          "BATTER",
          "BOWLER",
          "BATTING_PLAN",
          "BOWLING_PLAN",
          "FIELD",
          "DECLARATION",
          "FOLLOW_ON",
          "NEW_BALL"
        ]
      }
    },
    "redBallProfile": {
      "type": "string",
      "enum": [
        "CONSERVATIVE",
        "BALANCED",
        "AGGRESSIVE"
      ]
    }
  },
  "required": [
    "commandId",
    "expectedRevision",
    "matchRevision",
    "teamId",
    "categories"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:DelegationChange:1",
  "title": "DelegationChange"
}
