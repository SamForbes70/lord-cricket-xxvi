{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pitch": {
      "type": "object",
      "properties": {
        "seamBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "turnBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "variabilityBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "moistureBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "wearPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "seamBp",
        "turnBp",
        "variabilityBp",
        "moistureBp",
        "wearPoints"
      ],
      "additionalProperties": false
    },
    "weather": {
      "type": "string",
      "enum": [
        "DRY",
        "OVERCAST",
        "RAIN",
        "UNSAFE_LIGHT"
      ]
    },
    "outfieldSpeedBp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "ballId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "ballAgeLegalBalls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "weatherScheduleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    }
  },
  "required": [
    "pitch",
    "weather",
    "outfieldSpeedBp",
    "ballId",
    "ballAgeLegalBalls",
    "weatherScheduleId"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:Conditions:1",
  "title": "Conditions"
}
