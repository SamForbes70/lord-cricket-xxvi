{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "digestVersion": {
      "type": "string",
      "const": "LC_CAREER_MATCH_DIGEST_V1"
    },
    "fixtureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "groundId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "creaseOrder": {
      "type": "array",
      "prefixItems": [
        {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        },
        {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "fielding": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "teamId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "catches": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "stumpings": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "runOuts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "playerId",
          "teamId",
          "catches",
          "stumpings",
          "runOuts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "digestVersion",
    "fixtureId",
    "groundId",
    "creaseOrder",
    "fielding"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:CareerMatchDigest:1",
  "title": "CareerMatchDigest"
}
