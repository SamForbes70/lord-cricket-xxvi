{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))(?!.*\\\\)[A-Za-z0-9_./-]+$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "path",
    "bytes",
    "sha256"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:ArchiveEntry:1",
  "title": "ArchiveEntry"
}
