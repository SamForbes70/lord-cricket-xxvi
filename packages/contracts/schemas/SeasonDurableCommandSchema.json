{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "requestCanonical": {
      "type": "string"
    },
    "responseJson": {
      "type": "string"
    },
    "committedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "commandId",
    "requestCanonical",
    "responseJson",
    "committedRevision"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:SeasonDurableCommand:1",
  "title": "SeasonDurableCommand"
}
