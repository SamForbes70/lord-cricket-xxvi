{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectionVersion": {
      "type": "string",
      "const": "LC_T20_SEASON_PROJECTION_V1"
    },
    "seasonId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "scheduleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "competitionId": {
      "type": "string",
      "const": "LC_T20_LEAGUE_01"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 56
    },
    "cursor": {
      "type": "object",
      "properties": {
        "appliedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 56
        },
        "highestAppliedFixtureOrdinal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 55
            },
            {
              "type": "null"
            }
          ]
        },
        "missingFixtureOrdinals": {
          "maxItems": 56,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 55
          }
        }
      },
      "required": [
        "appliedCount",
        "highestAppliedFixtureOrdinal",
        "missingFixtureOrdinals"
      ],
      "additionalProperties": false
    },
    "appliedMatches": {
      "maxItems": 56,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fixtureId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "matchId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "fixtureOrdinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 55
          },
          "roundNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14
          },
          "homeTeamId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "awayTeamId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "sourceCompletionSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "resultKind": {
            "type": "string",
            "enum": [
              "WIN",
              "TIE",
              "NO_RESULT"
            ]
          },
          "winnerTeamId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "homePoints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "awayPoints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "nrrEligible": {
            "type": "boolean"
          },
          "homeRuns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "homeBalls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "awayRuns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "awayBalls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "fixtureId",
          "matchId",
          "fixtureOrdinal",
          "roundNumber",
          "homeTeamId",
          "awayTeamId",
          "sourceCompletionSha256",
          "resultKind",
          "winnerTeamId",
          "homePoints",
          "awayPoints",
          "nrrEligible",
          "homeRuns",
          "homeBalls",
          "awayRuns",
          "awayBalls"
        ],
        "additionalProperties": false
      }
    },
    "table": {
      "minItems": 8,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "teamId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "played": {
            "type": "integer",
            "minimum": 0,
            "maximum": 14
          },
          "wins": {
            "type": "integer",
            "minimum": 0,
            "maximum": 14
          },
          "losses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 14
          },
          "ties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 14
          },
          "noResults": {
            "type": "integer",
            "minimum": 0,
            "maximum": 14
          },
          "points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 28
          },
          "runsFor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "ballsFor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "runsAgainst": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "ballsAgainst": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "nrrNumerator": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "nrrDenominator": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "nrrX1000": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "headToHeadPoints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 28
          }
        },
        "required": [
          "rank",
          "teamId",
          "played",
          "wins",
          "losses",
          "ties",
          "noResults",
          "points",
          "runsFor",
          "ballsFor",
          "runsAgainst",
          "ballsAgainst",
          "nrrNumerator",
          "nrrDenominator",
          "nrrX1000",
          "headToHeadPoints"
        ],
        "additionalProperties": false
      }
    },
    "players": {
      "maxItems": 160,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "teamId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "matches": {
            "type": "integer",
            "minimum": 0,
            "maximum": 14
          },
          "runs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "dismissals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 14
          },
          "ballsFaced": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fours": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sixes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "battingAverageX100": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "strikeRateX100": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "bowlingRunsConceded": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bowlingLegalBalls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bowlingWickets": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maidens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bowlingAverageX100": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "economyX100": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "bowlingStrikeRateX100": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "playerId",
          "teamId",
          "matches",
          "runs",
          "dismissals",
          "ballsFaced",
          "fours",
          "sixes",
          "battingAverageX100",
          "strikeRateX100",
          "bowlingRunsConceded",
          "bowlingLegalBalls",
          "bowlingWickets",
          "maidens",
          "bowlingAverageX100",
          "economyX100",
          "bowlingStrikeRateX100"
        ],
        "additionalProperties": false
      }
    },
    "leaders": {
      "type": "object",
      "properties": {
        "runs": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "playerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "teamId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "playerId",
              "teamId",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "wickets": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "playerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "teamId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "playerId",
              "teamId",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "runs",
        "wickets"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "projectionVersion",
    "seasonId",
    "scheduleSha256",
    "competitionId",
    "revision",
    "cursor",
    "appliedMatches",
    "table",
    "players",
    "leaders"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:T20SeasonProjectionState:1",
  "title": "T20SeasonProjectionState"
}
