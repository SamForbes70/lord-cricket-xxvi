{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "GENERATE_DELIVERY"
    },
    "generatorVersion": {
      "type": "string",
      "const": "LC_CONDITIONAL_DELIVERY_V1"
    },
    "stagePackId": {
      "type": "string",
      "const": "synthetic-alpha-01-delivery-v1"
    },
    "stagePackHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "randomVersion": {
      "type": "string",
      "const": "SHA256_COUNTER_V1"
    },
    "probabilityVersion": {
      "type": "string",
      "const": "LC_INTEGER_PROBABILITY_V1"
    },
    "modelId": {
      "type": "string",
      "const": "synthetic-alpha-01"
    },
    "modelHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lutVersion": {
      "type": "string",
      "const": "LC_EXP_LUT_V1"
    },
    "lutHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rulesHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "matchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "attemptOrdinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "format": {
      "type": "string",
      "enum": [
        "T20",
        "ODI",
        "RED_BALL"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "T20_EARLY",
        "T20_MIDDLE",
        "T20_LATE",
        "ODI_EARLY",
        "ODI_MIDDLE",
        "ODI_LATE",
        "RED_BALL"
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "rulesId": {
          "type": "string",
          "enum": [
            "LC_T20_01",
            "LC_ODI_01",
            "LC_RED5_01"
          ]
        },
        "inningsIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deliveryIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "battingTeamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "bowlingTeamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "strikerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "nonStrikerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "bowlerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "keeperId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "outfieldIds": {
          "minItems": 9,
          "maxItems": 9,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        },
        "endsBefore": {
          "type": "object",
          "properties": {
            "north": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "south": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "required": [
            "north",
            "south"
          ],
          "additionalProperties": false
        },
        "strikerEnd": {
          "type": "string",
          "enum": [
            "NORTH",
            "SOUTH"
          ]
        },
        "runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wickets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "legalBalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allocatedBalls": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "targetToWin": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "freeHitPending": {
          "type": "boolean"
        },
        "ballAgeLegalBalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "rulesId",
        "inningsIndex",
        "deliveryIndex",
        "battingTeamId",
        "bowlingTeamId",
        "strikerId",
        "nonStrikerId",
        "bowlerId",
        "keeperId",
        "outfieldIds",
        "endsBefore",
        "strikerEnd",
        "runs",
        "wickets",
        "legalBalls",
        "allocatedBalls",
        "targetToWin",
        "freeHitPending",
        "ballAgeLegalBalls"
      ],
      "additionalProperties": false
    },
    "bowling": {
      "type": "object",
      "properties": {
        "bowlingStyle": {
          "type": "string",
          "enum": [
            "FAST",
            "MEDIUM",
            "OFF_SPIN",
            "LEG_SPIN",
            "SLOW_LEFT_ARM",
            "LEFT_ARM_WRIST"
          ]
        },
        "controlRating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "movementRating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "fatigueBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "line": {
          "type": "string",
          "enum": [
            "OFF",
            "STUMPS",
            "LEG"
          ]
        },
        "intendedLength": {
          "type": "string",
          "enum": [
            "YORKER",
            "FULL",
            "GOOD",
            "SHORT"
          ]
        },
        "effort": {
          "type": "string",
          "enum": [
            "CONSERVE",
            "NORMAL",
            "MAXIMUM"
          ]
        },
        "variationId": {
          "type": "string",
          "const": "stock"
        }
      },
      "required": [
        "bowlingStyle",
        "controlRating",
        "movementRating",
        "fatigueBp",
        "line",
        "intendedLength",
        "effort",
        "variationId"
      ],
      "additionalProperties": false
    },
    "batting": {
      "type": "object",
      "properties": {
        "defenceRating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "timingRating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "powerRating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "rotationRating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "vsPaceRating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "vsSpinRating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "aggression": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "intent": {
          "type": "string",
          "enum": [
            "NORMAL",
            "ROTATE",
            "PROTECT"
          ]
        },
        "attemptedStroke": {
          "type": "boolean"
        },
        "shotSectorWeights": {
          "minItems": 8,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      },
      "required": [
        "defenceRating",
        "timingRating",
        "powerRating",
        "rotationRating",
        "vsPaceRating",
        "vsSpinRating",
        "aggression",
        "intent",
        "attemptedStroke",
        "shotSectorWeights"
      ],
      "additionalProperties": false
    },
    "conditions": {
      "type": "object",
      "properties": {
        "seamBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "turnBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "seamBp",
        "turnBp"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "keeper": {
          "type": "object",
          "properties": {
            "keepingRating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "catchingRating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "throwingRating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "keepingRating",
            "catchingRating",
            "throwingRating"
          ],
          "additionalProperties": false
        },
        "slots": {
          "minItems": 9,
          "maxItems": 9,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "playerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "sector": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "depth": {
                "type": "string",
                "enum": [
                  "INNER",
                  "MIDDLE",
                  "DEEP"
                ]
              },
              "role": {
                "type": "string",
                "enum": [
                  "NORMAL",
                  "SLIP",
                  "GULLY"
                ]
              },
              "catchingRating": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "throwingRating": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "playerId",
              "sector",
              "depth",
              "role",
              "catchingRating",
              "throwingRating"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "keeper",
        "slots"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "generatorVersion",
    "stagePackId",
    "stagePackHash",
    "randomVersion",
    "probabilityVersion",
    "modelId",
    "modelHash",
    "lutVersion",
    "lutHash",
    "rulesHash",
    "matchId",
    "seed",
    "attemptOrdinal",
    "format",
    "phase",
    "context",
    "bowling",
    "batting",
    "conditions",
    "field"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:GenerateDeliveryRequest:1",
  "title": "GenerateDeliveryRequest"
}
