{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "playerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "teamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "battingPointsX100": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "bowlingPointsX100": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "fieldingPointsX100": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resultBonusX100": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "totalPointsX100": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "fromWinningTeam": {
      "type": "boolean"
    },
    "summaryLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    }
  },
  "required": [
    "playerId",
    "teamId",
    "battingPointsX100",
    "bowlingPointsX100",
    "fieldingPointsX100",
    "resultBonusX100",
    "totalPointsX100",
    "fromWinningTeam",
    "summaryLine"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:MatchAwardCandidate:1",
  "title": "MatchAwardCandidate"
}
