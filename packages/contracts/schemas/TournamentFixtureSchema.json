{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fixtureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "matchNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stage": {
      "type": "string",
      "enum": [
        "LEAGUE",
        "GROUP_A",
        "GROUP_B",
        "SEMI_FINAL",
        "FINAL",
        "SERIES"
      ]
    },
    "homeTeamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "awayTeamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "groundId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    }
  },
  "required": [
    "fixtureId",
    "matchNumber",
    "stage",
    "homeTeamId",
    "awayTeamId",
    "groundId"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:TournamentFixture:1",
  "title": "TournamentFixture"
}
