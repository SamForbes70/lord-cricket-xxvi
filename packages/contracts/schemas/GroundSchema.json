{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "groundId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "name": {
      "type": "string",
      "pattern": "^[\\s\\S]{1,80}$"
    },
    "pitchPrior": {
      "type": "object",
      "properties": {
        "seamBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "turnBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "variabilityBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "moistureBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "wearPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "seamBp",
        "turnBp",
        "variabilityBp",
        "moistureBp",
        "wearPoints"
      ],
      "additionalProperties": false
    },
    "sectorRadiiCm": {
      "minItems": 8,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "outfieldSpeedBp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    }
  },
  "required": [
    "groundId",
    "name",
    "pitchPrior",
    "sectorRadiiCm",
    "outfieldSpeedBp"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:Ground:1",
  "title": "Ground"
}
