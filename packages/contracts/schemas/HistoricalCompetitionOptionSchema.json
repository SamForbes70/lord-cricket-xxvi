{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "competitionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "format": {
      "type": "string",
      "enum": [
        "T20",
        "ODI",
        "RED_BALL"
      ]
    }
  },
  "required": [
    "competitionId",
    "label",
    "format"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:HistoricalCompetitionOption:1",
  "title": "HistoricalCompetitionOption"
}
