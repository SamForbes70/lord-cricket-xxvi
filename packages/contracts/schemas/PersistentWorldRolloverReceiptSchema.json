{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "receiptVersion": {
      "type": "string",
      "const": "LC_PERSISTENT_WORLD_ROLLOVER_RECEIPT_V1"
    },
    "fromSeasonNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 199
    },
    "toSeasonNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "closedSeasonId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "closedSeasonStateSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "closedSeasonRecordSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nextSeasonId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "nextStartDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "nextScheduleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "receiptVersion",
    "fromSeasonNumber",
    "toSeasonNumber",
    "closedSeasonId",
    "closedSeasonStateSha256",
    "closedSeasonRecordSha256",
    "nextSeasonId",
    "nextStartDate",
    "nextScheduleSha256"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:PersistentWorldRolloverReceipt:1",
  "title": "PersistentWorldRolloverReceipt"
}
