{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rulesId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "format": {
      "type": "string",
      "enum": [
        "T20",
        "ODI",
        "RED_BALL"
      ]
    },
    "referenceEdition": {
      "type": "string",
      "const": "MCC_2017_FOURTH_EDITION_2026"
    },
    "effectiveDate": {
      "type": "string",
      "const": "2026-10-01"
    },
    "customProfile": {
      "type": "boolean",
      "const": true
    },
    "ballsPerOver": {
      "type": "number",
      "const": 6
    },
    "playersPerXI": {
      "type": "number",
      "const": 11
    },
    "wicketsToAllOut": {
      "type": "number",
      "const": 10
    },
    "inningsPerTeam": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "allocatedBalls": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "bowlerMaxBalls": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "consecutiveOvers": {
      "type": "boolean",
      "const": false
    },
    "freeHitAfterNoBall": {
      "type": "boolean"
    },
    "declarations": {
      "type": "boolean"
    },
    "followOnLead": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "newBallAfterLegalBalls": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "fieldPhases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fromLegalBall": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxOutside": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          }
        },
        "required": [
          "fromLegalBall",
          "maxOutside"
        ],
        "additionalProperties": false
      }
    },
    "maxLegSide": {
      "type": "number",
      "const": 5
    },
    "maxBehindSquareLegSide": {
      "type": "number",
      "const": 2
    },
    "limitedOversRain": {
      "type": "boolean",
      "const": false
    },
    "superOver": {
      "type": "boolean",
      "const": false
    },
    "supportedClauses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "localVariations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixtureIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "validationStatus": {
      "type": "string",
      "const": "CONTRACT_ONLY"
    }
  },
  "required": [
    "rulesId",
    "schemaVersion",
    "format",
    "referenceEdition",
    "effectiveDate",
    "customProfile",
    "ballsPerOver",
    "playersPerXI",
    "wicketsToAllOut",
    "inningsPerTeam",
    "allocatedBalls",
    "bowlerMaxBalls",
    "consecutiveOvers",
    "freeHitAfterNoBall",
    "declarations",
    "followOnLead",
    "newBallAfterLegalBalls",
    "fieldPhases",
    "maxLegSide",
    "maxBehindSquareLegSide",
    "limitedOversRain",
    "superOver",
    "supportedClauses",
    "localVariations",
    "fixtureIds",
    "validationStatus"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:RuleManifest:1",
  "title": "RuleManifest"
}
