{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "stageName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "address": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "domain": {
          "type": "string",
          "enum": [
            "MATCH_DELIVERY",
            "TOSS",
            "WEATHER",
            "AI_TIE_BREAK",
            "CAREER_TRAINING",
            "WORLD_GENERATION",
            "PREDICTION"
          ]
        },
        "entityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "eventOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stageName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "drawIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "seed",
        "domain",
        "entityId",
        "eventOrdinal",
        "stageName",
        "drawIndex"
      ],
      "additionalProperties": false
    },
    "draw": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "selectedCategoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "categories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "allowed": {
            "type": "boolean"
          },
          "logitBp": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "lutIndex": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "mass": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cumulative": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "allowed",
          "logitBp",
          "lutIndex",
          "mass",
          "cumulative"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "stageName",
    "address",
    "draw",
    "selectedCategoryId",
    "categories"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:GeneratorTraceStage:1",
  "title": "GeneratorTraceStage"
}
