{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "LC_SCENARIO_RECORD_LEDGER_V1"
    },
    "records": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenarioId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "challengeSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "completions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "failures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bestMarginType": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "RUNS",
                  "WICKETS",
                  "INNINGS"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "bestMarginValue": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "lastOutcome": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "COMPLETED",
                  "FAILED"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "scenarioId",
          "challengeSha256",
          "attempts",
          "completions",
          "failures",
          "bestMarginType",
          "bestMarginValue",
          "lastOutcome"
        ],
        "additionalProperties": false
      }
    },
    "attempts": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gameId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "scenarioId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "challengeSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "playerTeamId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "objective": {
            "type": "string",
            "enum": [
              "WIN",
              "AVOID_DEFEAT"
            ]
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "COMPLETED",
                  "FAILED"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "resultText": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "gameId",
          "scenarioId",
          "challengeSha256",
          "playerTeamId",
          "objective",
          "outcome",
          "resultText"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaId",
    "records",
    "attempts"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:ScenarioRecordLedger:1",
  "title": "ScenarioRecordLedger"
}
