{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "metric": {
      "type": "string",
      "enum": [
        "RUNS",
        "BATTING_AVERAGE",
        "BATTING_STRIKE_RATE",
        "HIGH_SCORE",
        "SIXES",
        "WICKETS",
        "BOWLING_AVERAGE",
        "ECONOMY",
        "BOWLING_STRIKE_RATE",
        "BEST_BOWLING",
        "FIELDING_DISMISSALS",
        "CATCHES"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "sortDirection": {
      "type": "string",
      "enum": [
        "DESC",
        "ASC"
      ]
    },
    "qualificationRule": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "minDenominator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "denominatorField": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "secondaryRule": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "summary",
        "minDenominator",
        "denominatorField",
        "secondaryRule"
      ],
      "additionalProperties": false
    },
    "denominatorDefinition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "nullPolicy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "tieRule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "entries": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "tied": {
            "type": "boolean"
          },
          "playerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "teamId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "RETIRED"
            ]
          },
          "qualified": {
            "type": "boolean"
          },
          "primaryDisplay": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "primaryValueX100": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "secondaryDisplay": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "denominatorCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "denominatorLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "contributingFixtureIds": {
            "minItems": 1,
            "maxItems": 2800,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          }
        },
        "required": [
          "rank",
          "tied",
          "playerId",
          "teamId",
          "status",
          "qualified",
          "primaryDisplay",
          "primaryValueX100",
          "secondaryDisplay",
          "denominatorCount",
          "denominatorLabel",
          "contributingFixtureIds"
        ],
        "additionalProperties": false
      }
    },
    "qualifiedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "totalCandidatesCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "metric",
    "title",
    "sortDirection",
    "qualificationRule",
    "denominatorDefinition",
    "nullPolicy",
    "tieRule",
    "entries",
    "qualifiedCount",
    "totalCandidatesCount"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:HistoricalLeaderboardTable:1",
  "title": "HistoricalLeaderboardTable"
}
