{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "saveId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "currentSerial": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currentGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "corruptedGenerations": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2
      }
    },
    "validGenerations": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "checkpointSerial": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "completedFixtures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 56
          },
          "currentDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "phase": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "COMPLETE"
            ]
          },
          "stateSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          }
        },
        "required": [
          "generation",
          "checkpointSerial",
          "revision",
          "completedFixtures",
          "currentDate",
          "phase",
          "stateSha256",
          "createdAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "saveId",
    "title",
    "currentSerial",
    "currentGeneration",
    "corruptedGenerations",
    "validGenerations"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:SeasonCheckpointInspection:1",
  "title": "SeasonCheckpointInspection"
}
