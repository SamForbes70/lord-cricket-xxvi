{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "const": "SET_TRAINING_DIRECTIVE"
    },
    "playerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "previousDirective": {
      "type": "string",
      "enum": [
        "REST",
        "BATTING_PRACTICE",
        "BOWLING_PRACTICE",
        "FIELDING_PRACTICE"
      ]
    },
    "directive": {
      "type": "string",
      "enum": [
        "REST",
        "BATTING_PRACTICE",
        "BOWLING_PRACTICE",
        "FIELDING_PRACTICE"
      ]
    },
    "changed": {
      "type": "boolean"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stateSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "command",
    "playerId",
    "previousDirective",
    "directive",
    "changed",
    "revision",
    "stateSha256"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:SetTrainingDirectiveReceipt:1",
  "title": "SetTrainingDirectiveReceipt"
}
