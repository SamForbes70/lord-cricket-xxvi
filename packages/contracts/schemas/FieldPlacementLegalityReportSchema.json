{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "isLegal": {
      "type": "boolean"
    },
    "format": {
      "type": "string",
      "enum": [
        "T20",
        "ODI",
        "RED_BALL"
      ]
    },
    "strikerHand": {
      "type": "string",
      "enum": [
        "R",
        "L"
      ]
    },
    "phaseLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "outsideCircleCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "maxOutsideCircle": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "legSideCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "maxLegSide": {
      "type": "number",
      "const": 5
    },
    "behindSquareLegCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "maxBehindSquareLeg": {
      "type": "number",
      "const": 2
    },
    "duplicateSlotIds": {
      "maxItems": 9,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "violations": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "SLOT_COUNT",
              "UNIQUE_PLAYERS",
              "DUPLICATE_POSITION",
              "UNSUPPORTED_POSITION",
              "CIRCLE_RESTRICTION",
              "LEG_SIDE_LIMIT",
              "BEHIND_SQUARE_LEG_LIMIT"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "affectedSlotIds": {
            "maxItems": 9,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          }
        },
        "required": [
          "code",
          "message",
          "affectedSlotIds"
        ],
        "additionalProperties": false
      }
    },
    "summaryText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    }
  },
  "required": [
    "isLegal",
    "format",
    "strikerHand",
    "phaseLabel",
    "outsideCircleCount",
    "maxOutsideCircle",
    "legSideCount",
    "maxLegSide",
    "behindSquareLegCount",
    "maxBehindSquareLeg",
    "duplicateSlotIds",
    "violations",
    "summaryText"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:FieldPlacementLegalityReport:1",
  "title": "FieldPlacementLegalityReport"
}
