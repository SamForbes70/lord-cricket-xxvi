{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "RANDOM"
        },
        "version": {
          "type": "string",
          "const": "SHA256_COUNTER_V1"
        },
        "address": {
          "type": "object",
          "properties": {
            "seed": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "domain": {
              "type": "string",
              "enum": [
                "MATCH_DELIVERY",
                "TOSS",
                "WEATHER",
                "AI_TIE_BREAK",
                "CAREER_TRAINING",
                "WORLD_GENERATION",
                "PREDICTION"
              ]
            },
            "entityId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "eventOrdinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "stageName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "drawIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "seed",
            "domain",
            "entityId",
            "eventOrdinal",
            "stageName",
            "drawIndex"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "version",
        "address"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "HASH_STATE"
        },
        "version": {
          "type": "string",
          "const": "LC_CANONICAL_JSON_V1_SHA256"
        },
        "value": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "kind",
        "version",
        "value"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "urn:lcxxvi:DeterminismRequest:1",
  "title": "DeterminismRequest"
}
