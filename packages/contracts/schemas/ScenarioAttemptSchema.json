{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gameId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "challengeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "playerTeamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "objective": {
      "type": "string",
      "enum": [
        "WIN",
        "AVOID_DEFEAT"
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "COMPLETED",
            "FAILED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "resultText": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "gameId",
    "scenarioId",
    "challengeSha256",
    "playerTeamId",
    "objective",
    "outcome",
    "resultText"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:ScenarioAttempt:1",
  "title": "ScenarioAttempt"
}
