{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fixtureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "matchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "seasonNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "calendarYear": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 9999
    },
    "roundNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "matchDayDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "competitionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "format": {
      "type": "string",
      "const": "T20"
    },
    "groundId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "homeTeamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "awayTeamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "teamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "opponentTeamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "battedInnings": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "battingPosition": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 11
        },
        {
          "type": "null"
        }
      ]
    },
    "runsScored": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "ballsFaced": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "fours": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "sixes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "notOut": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "bowledLegalBalls": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "bowlingRunsConceded": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "bowlingWickets": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        {
          "type": "null"
        }
      ]
    },
    "maidens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        {
          "type": "null"
        }
      ]
    },
    "catches": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "stumpings": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "runOuts": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "archiveEvaluated": {
      "type": "boolean"
    },
    "archiveReplayAvailable": {
      "type": "boolean"
    },
    "resultSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "sourceCompletionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "fixtureId",
    "matchId",
    "seasonNumber",
    "calendarYear",
    "roundNumber",
    "matchDayDate",
    "competitionId",
    "format",
    "groundId",
    "homeTeamId",
    "awayTeamId",
    "teamId",
    "opponentTeamId",
    "battedInnings",
    "battingPosition",
    "runsScored",
    "ballsFaced",
    "fours",
    "sixes",
    "notOut",
    "bowledLegalBalls",
    "bowlingRunsConceded",
    "bowlingWickets",
    "maidens",
    "catches",
    "stumpings",
    "runOuts",
    "archiveEvaluated",
    "archiveReplayAvailable",
    "resultSummary",
    "sourceCompletionSha256"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:HistoricalContributingMatch:1",
  "title": "HistoricalContributingMatch"
}
