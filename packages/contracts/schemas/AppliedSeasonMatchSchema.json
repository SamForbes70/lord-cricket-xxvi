{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fixtureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "matchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "fixtureOrdinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 55
    },
    "roundNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "homeTeamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "awayTeamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "sourceCompletionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "resultKind": {
      "type": "string",
      "enum": [
        "WIN",
        "TIE",
        "NO_RESULT"
      ]
    },
    "winnerTeamId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "homePoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "awayPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "nrrEligible": {
      "type": "boolean"
    },
    "homeRuns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "homeBalls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "awayRuns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "awayBalls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "fixtureId",
    "matchId",
    "fixtureOrdinal",
    "roundNumber",
    "homeTeamId",
    "awayTeamId",
    "sourceCompletionSha256",
    "resultKind",
    "winnerTeamId",
    "homePoints",
    "awayPoints",
    "nrrEligible",
    "homeRuns",
    "homeBalls",
    "awayRuns",
    "awayBalls"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:AppliedSeasonMatch:1",
  "title": "AppliedSeasonMatch"
}
