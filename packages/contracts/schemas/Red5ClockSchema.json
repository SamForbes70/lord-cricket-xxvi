{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "localSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "phase": {
      "type": "string",
      "enum": [
        "PLAY",
        "LUNCH",
        "TEA",
        "INNINGS_INTERVAL",
        "STUMPS",
        "RAIN",
        "COMPLETE"
      ]
    },
    "dayLegalBalls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "finalHourActive": {
      "type": "boolean"
    },
    "finalHourBallsRemaining": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "overMustFinish": {
      "type": "boolean"
    },
    "delaySecondsToday": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "day",
    "localSeconds",
    "phase",
    "dayLegalBalls",
    "finalHourActive",
    "finalHourBallsRemaining",
    "overMustFinish",
    "delaySecondsToday"
