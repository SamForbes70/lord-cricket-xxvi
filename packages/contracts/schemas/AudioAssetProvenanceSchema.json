{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "cueKind": {
      "type": "string",
      "enum": [
        "BAT_BALL_DOT",
        "BAT_BALL_SINGLE",
        "BOUNDARY_FOUR",
        "BOUNDARY_SIX",
        "WICKET_FALL",
        "MILESTONE_CHIME",
        "OVER_BELL",
        "INNINGS_CHANGE",
        "MATCH_COMPLETE",
        "UI_CLICK"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "CROWD",
        "EFFECTS",
        "COMMENTARY",
        "INTERFACE"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "license": {
      "type": "string",
      "const": "MIT_ORIGINAL_LORD_CRICKET_XXVI"
    },
    "origin": {
      "type": "string",
      "enum": [
        "ORIGINAL_PROCEDURAL_SYNTH",
        "ORIGINAL_IN_REPO_PCM"
      ]
    },
    "synthesisProfile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "assetId",
    "cueKind",
    "channel",
    "title",
    "author",
    "license",
    "origin",
    "synthesisProfile",
    "durationMs",
    "sha256"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:AudioAssetProvenance:1",
  "title": "AudioAssetProvenance"
}
