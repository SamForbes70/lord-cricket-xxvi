{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "playerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "fatigueBp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "availability": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE"
      ]
    },
    "availabilityReason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        {
          "type": "null"
        }
      ]
    },
    "unavailableThrough": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "directive": {
      "type": "string",
      "enum": [
        "REST",
        "BATTING_PRACTICE",
        "BOWLING_PRACTICE",
        "FIELDING_PRACTICE"
      ]
    },
    "battingReadiness": {
      "type": "integer",
      "minimum": -3,
      "maximum": 3
    },
    "bowlingReadiness": {
      "type": "integer",
      "minimum": -3,
      "maximum": 3
    },
    "fieldingReadiness": {
      "type": "integer",
      "minimum": -3,
      "maximum": 3
    }
  },
  "required": [
    "playerId",
    "fatigueBp",
    "availability",
    "availabilityReason",
    "unavailableThrough",
    "directive",
    "battingReadiness",
    "bowlingReadiness",
    "fieldingReadiness"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:SquadPlayerTrainingConditionView:1",
  "title": "SquadPlayerTrainingConditionView"
}
