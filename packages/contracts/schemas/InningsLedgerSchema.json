{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "engineVersion": {
      "type": "string",
      "const": "LC_SCORING_V1"
    },
    "rulesId": {
      "type": "string",
      "enum": [
        "LC_T20_01",
        "LC_ODI_01",
        "LC_RED5_01"
      ]
    },
    "innings": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "battingTeamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "bowlingTeamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wickets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "legalBalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deliveryAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "targetToWin": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "allocatedBalls": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "extras": {
          "type": "object",
          "properties": {
            "wides": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "noBalls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "byes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "legByes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "penalties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "wides",
            "noBalls",
            "byes",
            "legByes",
            "penalties"
          ],
          "additionalProperties": false
        },
        "northBatterId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "southBatterId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "strikerEnd": {
          "type": "string",
          "enum": [
            "NORTH",
            "SOUTH"
          ]
        },
        "battingOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        },
        "dismissed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        },
        "bowlerId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "previousOverBowlerId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bowlerLegalBalls": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "freeHitPending": {
          "type": "boolean"
        },
        "ballAgeLegalBalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "index",
        "battingTeamId",
        "bowlingTeamId",
        "runs",
        "wickets",
        "legalBalls",
        "deliveryAttempts",
        "targetToWin",
        "allocatedBalls",
        "extras",
        "northBatterId",
        "southBatterId",
        "strikerEnd",
        "battingOrder",
        "dismissed",
        "bowlerId",
        "previousOverBowlerId",
        "bowlerLegalBalls",
        "freeHitPending",
        "ballAgeLegalBalls",
        "complete"
      ],
      "additionalProperties": false
    },
    "nextDeliveryIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "batting": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "runs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "ballsFaced": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fours": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sixes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "dismissed": {
            "type": "boolean"
          }
        },
        "required": [
          "runs",
          "ballsFaced",
          "fours",
          "sixes",
          "dismissed"
        ],
        "additionalProperties": false
      }
    },
    "dismissals": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "BOWLED",
              "LBW",
              "CAUGHT",
              "RUN_OUT",
              "STUMPED",
              "HIT_WICKET"
            ]
          },
          "playerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "creditedBowlerId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "fielderId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "wicketEnd": {
            "type": "string",
            "enum": [
              "NORTH",
              "SOUTH"
            ]
          }
        },
        "required": [
          "kind",
          "playerId",
          "creditedBowlerId",
          "fielderId",
          "wicketEnd"
        ],
        "additionalProperties": false
      }
    },
    "bowling": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "runsConceded": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "legalBalls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "wickets": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maidens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "runsConceded",
          "legalBalls",
          "wickets",
          "maidens"
        ],
        "additionalProperties": false
      }
    },
    "keeperId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "outfieldIds": {
      "minItems": 9,
      "maxItems": 9,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "currentOverRuns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "engineVersion",
    "rulesId",
    "innings",
    "nextDeliveryIndex",
    "batting",
    "dismissals",
    "bowling",
    "keeperId",
    "outfieldIds",
    "currentOverRuns"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:InningsLedger:1",
  "title": "InningsLedger"
}
