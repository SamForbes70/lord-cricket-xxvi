{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "archiveVersion": {
      "type": "string",
      "const": "LC_PERSISTENT_WORLD_PORTABLE_V1"
    },
    "saveSchema": {
      "type": "string",
      "enum": [
        "LC_PERSISTENT_WORLD_SAVE_V1",
        "LC_PERSISTENT_WORLD_SAVE_V1_PRESENTATION"
      ]
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "summary": {
      "type": "object",
      "properties": {
        "saveId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "AUTO",
            "MANUAL",
            "IMPORTED"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "worldId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "careerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "controlledTeamId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currentSeasonNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "currentCalendarYear": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 9999
        },
        "completedSeasonCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 199
        },
        "seasonId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "currentDate": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completedFixtures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 56
        },
        "phase": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "COMPLETE"
          ]
        },
        "stateSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        }
      },
      "required": [
        "saveId",
        "kind",
        "title",
        "worldId",
        "careerId",
        "controlledTeamId",
        "currentSeasonNumber",
        "currentCalendarYear",
        "completedSeasonCount",
        "seasonId",
        "currentDate",
        "revision",
        "completedFixtures",
        "phase",
        "stateSha256",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "careerProjectionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "worldCopySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "matchEventArchiveCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11200
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "archiveVersion",
    "saveSchema",
    "exportedAt",
    "summary",
    "careerProjectionSha256",
    "matchEventArchiveCount",
    "files"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:PersistentWorldPortableManifest:1",
  "title": "PersistentWorldPortableManifest"
}
