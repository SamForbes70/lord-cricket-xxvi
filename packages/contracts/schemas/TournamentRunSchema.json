{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "LC_TOURNAMENT_RUN_V1"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "competitionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "competitionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "results": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fixtureId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "homeTeamId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "awayTeamId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "resultKind": {
            "type": "string",
            "enum": [
              "WIN",
              "TIE"
            ]
          },
          "winnerTeamId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "superOverWinnerTeamId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "homeRuns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "homeWickets": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "homeLegalBalls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "awayRuns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "awayWickets": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "awayLegalBalls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "resultText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "lastEventHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "fixtureId",
          "homeTeamId",
          "awayTeamId",
          "resultKind",
          "winnerTeamId",
          "superOverWinnerTeamId",
          "homeRuns",
          "homeWickets",
          "homeLegalBalls",
          "awayRuns",
          "awayWickets",
          "awayLegalBalls",
          "resultText",
          "lastEventHash"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaId",
    "runId",
    "competitionId",
    "competitionSha256",
    "seed",
    "results"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:TournamentRun:1",
  "title": "TournamentRun"
}
