            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "BATTER_RETIRED"
              },
              "commandId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "sourceEventId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "playerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "retirementStatus": {
                "type": "string",
                "enum": [
                  "RETIRED_OUT",
                  "RETIRED_NOT_OUT"
                ]
              },
              "battingTeamDelta": {
                "type": "number",
                "const": 0
              },
              "wicketDelta": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 0
                  },
                  {
                    "type": "number",
                    "const": 1
                  }
                ]
              },
              "bowlerWicketDelta": {
                "type": "number",
                "const": 0
              },
              "legalBallsDelta": {
                "type": "number",
                "const": 0
              }
            },
            "required": [
              "kind",
              "commandId",
              "sourceEventId",
              "playerId",
              "retirementStatus",
              "battingTeamDelta",
              "wicketDelta",
              "bowlerWicketDelta",
              "legalBallsDelta"
            ],
            "additionalProperties": false
          }
        ]
