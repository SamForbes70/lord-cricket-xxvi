                        "BOWLED",
                        "LBW",
                        "CAUGHT",
                        "RUN_OUT",
                        "STUMPED",
                        "HIT_WICKET"
                      ]
                    },
                    "playerId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
