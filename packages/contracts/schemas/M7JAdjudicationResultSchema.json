                "noBalls": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "byes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "legByes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
