    },
    "baseDelivery": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "DELIVERY_RECORDED"
            },
            "inningsIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "deliveryIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "strikerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "nonStrikerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "bowlerId": {
