        "deliveryAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bowlerRunsConcededDelta": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bowlerWicketsDelta": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
