            "type",
            "inningsIndex",
            "deliveryIndex",
            "strikerId",
            "nonStrikerId",
            "bowlerId",
            "legality",
            "legalBall",
            "countsAsBallFaced",
            "batRuns",
            "extras",
            "completedRuns",
            "boundary",
            "dismissal",
            "endsAfter",
            "shotSector",
            "trajectory",
            "executedLength",
            "fieldOutcome",
            "elapsedSeconds",
            "freeHitNext"
