              "type": "string",
              "enum": [
                "LEGAL",
                "WIDE",
                "NO_BALL",
                "DEAD"
              ]
            },
            "legalBall": {
              "type": "boolean"
            },
            "countsAsBallFaced": {
              "type": "boolean"
            },
            "batRuns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
