{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "availabilityVersion": {
      "type": "string",
      "const": "LC_T20_AVAILABILITY_PACK_V1"
    },
    "packId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "worldPackId": {
      "type": "string",
      "const": "fictional-eight-01"
    },
    "worldCanonicalSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "maxItems": 320,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "source": {
            "type": "string",
            "const": "MANUAL_FIXTURE_PACK"
          }
        },
        "required": [
          "playerId",
          "startDate",
          "endDate",
          "reason",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "availabilityVersion",
    "packId",
    "worldPackId",
    "worldCanonicalSha256",
    "entries"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:CareerAvailabilityPack:1",
  "title": "CareerAvailabilityPack"
}
