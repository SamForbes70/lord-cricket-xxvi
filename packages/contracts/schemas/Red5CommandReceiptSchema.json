{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "committedRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "fromSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "toSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "lastEventHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "commandId",
    "committedRevision",
    "fromSequence",
    "toSequence",
    "lastEventHash"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:Red5CommandReceipt:1",
  "title": "Red5CommandReceipt"
}
