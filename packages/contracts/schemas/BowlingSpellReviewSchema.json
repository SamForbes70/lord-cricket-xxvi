{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "spellId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "inningsIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "spellNumberInInnings": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "bowlerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "bowlerName": {
      "type": "string",
      "pattern": "^[\\s\\S]{1,80}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "IN_PROGRESS",
        "BETWEEN_OVERS",
        "COMPLETED"
      ]
    },
    "startOver": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "endOver": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "acceptedPlan": {
      "type": "object",
      "properties": {
        "primaryLine": {
          "type": "string",
          "enum": [
            "OFF",
            "STUMPS",
            "LEG"
          ]
        },
        "primaryLength": {
          "type": "string",
          "enum": [
            "YORKER",
            "FULL",
            "GOOD",
            "SHORT"
          ]
        },
        "primaryEffort": {
          "type": "string",
          "enum": [
            "CONSERVE",
            "NORMAL",
            "MAXIMUM"
          ]
        },
        "primaryVariationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "latestRingFielders": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "latestBoundaryFielders": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "latestCloseCatchers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "planChangesCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fieldChangesCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "primaryLine",
        "primaryLength",
        "primaryEffort",
        "primaryVariationId",
        "latestRingFielders",
        "latestBoundaryFielders",
        "latestCloseCatchers",
        "planChangesCount",
        "fieldChangesCount"
      ],
      "additionalProperties": false
    },
    "outcomes": {
      "type": "object",
      "properties": {
        "legalBalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "oversDisplay": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-5]$"
        },
        "deliveryAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "runsConceded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wickets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "singles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "boundaries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sixes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wides": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "noBalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "economyX100": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "intendedLengthMatches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "intendedLengthEvaluatedBalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "executedLengths": {
          "type": "object",
          "properties": {
            "YORKER": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "FULL": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "GOOD": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "SHORT": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "FULL_TOSS": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "YORKER",
            "FULL",
            "GOOD",
            "SHORT",
            "FULL_TOSS"
          ],
          "additionalProperties": false
        },
        "trajectories": {
          "type": "object",
          "properties": {
            "GROUND": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "AERIAL": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "EDGE": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "NO_CONTACT": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "GROUND",
            "AERIAL",
            "EDGE",
            "NO_CONTACT"
          ],
          "additionalProperties": false
        },
        "fieldOutcomes": {
          "type": "object",
          "properties": {
            "STOP": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "CATCH": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "DROP": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "MISS": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "RUN_OUT": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "STOP",
            "CATCH",
            "DROP",
            "MISS",
            "RUN_OUT"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "legalBalls",
        "oversDisplay",
        "deliveryAttempts",
        "runsConceded",
        "wickets",
        "dots",
        "singles",
        "boundaries",
        "fours",
        "sixes",
        "wides",
        "noBalls",
        "economyX100",
        "intendedLengthMatches",
        "intendedLengthEvaluatedBalls",
        "executedLengths",
        "trajectories",
        "fieldOutcomes"
      ],
      "additionalProperties": false
    },
    "factualSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 420
    }
  },
  "required": [
    "spellId",
    "inningsIndex",
    "spellNumberInInnings",
    "bowlerId",
    "bowlerName",
    "status",
    "startOver",
    "endOver",
    "acceptedPlan",
    "outcomes",
    "factualSummary"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:BowlingSpellReview:1",
  "title": "BowlingSpellReview"
}
