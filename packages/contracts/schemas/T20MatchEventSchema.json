    },
    "payload": {
      "$ref": "#/$defs/__schema0"
    },
    "previousHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stateHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "eventHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
