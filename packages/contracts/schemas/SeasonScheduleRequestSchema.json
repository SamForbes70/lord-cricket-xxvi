{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scheduleVersion": {
      "type": "string",
      "const": "LC_T20_SEASON_SCHEDULE_V1"
    },
    "seasonId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "gameId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "competitionId": {
      "type": "string",
      "const": "LC_T20_LEAGUE_01"
    },
    "worldPackId": {
      "type": "string",
      "const": "fictional-eight-01"
    },
    "worldCanonicalSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "seasonSeed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "teamIds": {
      "minItems": 8,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "groundIds": {
      "minItems": 8,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "homeGroundIds": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    }
  },
  "required": [
    "scheduleVersion",
    "seasonId",
    "gameId",
    "competitionId",
    "worldPackId",
    "worldCanonicalSha256",
    "seasonSeed",
    "startDate",
    "teamIds",
    "groundIds",
    "homeGroundIds"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:SeasonScheduleRequest:1",
  "title": "SeasonScheduleRequest"
}
