{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "archiveVersion": {
      "type": "string",
      "const": "LC_COMPLETED_CAREER_MATCH_EVENT_ARCHIVE_V2_LIFECYCLE"
    },
    "seasonId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "scheduleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixtureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "matchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "fixtureOrdinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 55
    },
    "roundNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "matchDayDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "source": {
      "type": "string",
      "enum": [
        "OFFSCREEN",
        "USER_MATCH"
      ]
    },
    "sourceCompletionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rosterPackSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "preparation": {
      "type": "object",
      "properties": {
        "gameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "matchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "format": {
          "type": "string",
          "enum": [
            "T20",
            "ODI",
            "RED_BALL"
          ]
        },
        "selection": {
          "type": "object",
          "properties": {
            "groundId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "teams": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "properties": {
                    "teamId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                    },
                    "playerIds": {
                      "minItems": 11,
                      "maxItems": 11,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                      }
                    },
                    "captainId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                    },
                    "keeperId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                    }
                  },
                  "required": [
                    "teamId",
                    "playerIds",
                    "captainId",
                    "keeperId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "teamId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                    },
                    "playerIds": {
                      "minItems": 11,
                      "maxItems": 11,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                      }
                    },
                    "captainId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                    },
                    "keeperId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                    }
                  },
                  "required": [
                    "teamId",
                    "playerIds",
                    "captainId",
                    "keeperId"
                  ],
                  "additionalProperties": false
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "items": false
            }
          },
          "required": [
            "groundId",
            "teams"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "gameId",
        "matchId",
        "seed",
        "format",
        "selection"
      ],
      "additionalProperties": false
    },
    "eventChain": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "LC_T20_EVENT_CHAIN_V1"
        },
        "genesisHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "finalEventHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "finalStateHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "executionManifestHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "version",
        "genesisHash",
        "finalEventHash",
        "finalStateHash",
        "eventCount",
        "executionManifestHash"
      ],
      "additionalProperties": false
    },
    "events": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "const": "LC_T20_EVENT_CHAIN_V1"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "commandId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "payload": {
            "$ref": "#/$defs/__schema0"
          },
          "previousHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stateHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "eventHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "version",
          "sequence",
          "commandId",
          "type",
          "payload",
          "previousHash",
          "stateHash",
          "eventHash"
        ],
        "additionalProperties": false
      }
    },
    "scorecardSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "archiveVersion",
    "seasonId",
    "scheduleSha256",
    "fixtureId",
    "matchId",
    "fixtureOrdinal",
    "roundNumber",
    "matchDayDate",
    "source",
    "sourceCompletionSha256",
    "rosterPackSha256",
    "preparation",
    "eventChain",
    "events",
    "scorecardSha256"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "urn:lcxxvi:CompletedLifecycleMatchEventArchiveCore:1",
  "title": "CompletedLifecycleMatchEventArchiveCore"
}
