{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seasonNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "calendarYear": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 9999
    },
    "phase": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "COMPLETE"
      ]
    },
    "matchesCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "seasonNumber",
    "calendarYear",
    "phase",
    "matchesCount"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:HistoricalSeasonOption:1",
  "title": "HistoricalSeasonOption"
}
