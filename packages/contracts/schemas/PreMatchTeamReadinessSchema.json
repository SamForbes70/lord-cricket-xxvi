{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "teamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "teamName": {
      "type": "string",
      "pattern": "^[\\s\\S]{1,80}$"
    },
    "squadSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "selectedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "selectedKeepers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "selectedBowlingOptions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "selectedPaceOptions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "selectedSpinOptions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "selectedLeftHandBatters": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "freshInXI": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "tiredInXI": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "balanceSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "players": {
      "minItems": 11,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[\\s\\S]{1,80}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "BATTER",
              "BOWLER",
              "ALLROUNDER",
              "KEEPER"
            ]
          },
          "batHand": {
            "type": "string",
            "enum": [
              "R",
              "L"
            ]
          },
          "bowlingStyle": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "FAST",
                  "MEDIUM",
                  "OFF_SPIN",
                  "LEG_SPIN",
                  "SLOW_LEFT_ARM",
                  "LEFT_ARM_WRIST"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "canBowl": {
            "type": "boolean"
          },
          "selectedInXI": {
            "type": "boolean"
          },
          "fatigueBp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "readinessDelta": {
            "type": "integer",
            "minimum": -20,
            "maximum": 20
          },
          "conditionBand": {
            "type": "string",
            "enum": [
              "FRESH",
              "READY",
              "WORKED",
              "TIRED"
            ]
          }
        },
        "required": [
          "playerId",
          "name",
          "role",
          "batHand",
          "bowlingStyle",
          "canBowl",
          "selectedInXI",
          "fatigueBp",
          "readinessDelta",
          "conditionBand"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "teamId",
    "teamName",
    "squadSize",
    "selectedCount",
    "selectedKeepers",
    "selectedBowlingOptions",
    "selectedPaceOptions",
    "selectedSpinOptions",
    "selectedLeftHandBatters",
    "freshInXI",
    "tiredInXI",
    "balanceSummary",
    "players"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:PreMatchTeamReadiness:1",
  "title": "PreMatchTeamReadiness"
}
