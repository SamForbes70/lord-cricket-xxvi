{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rulesId": {
      "type": "string",
      "enum": [
        "LC_T20_01",
        "LC_ODI_01",
        "LC_RED5_01"
      ]
    },
    "inningsIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deliveryIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "battingTeamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "bowlingTeamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "strikerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "nonStrikerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "bowlerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "keeperId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "outfieldIds": {
      "minItems": 9,
      "maxItems": 9,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "endsBefore": {
      "type": "object",
      "properties": {
        "north": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "south": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "north",
        "south"
      ],
      "additionalProperties": false
    },
    "strikerEnd": {
      "type": "string",
      "enum": [
        "NORTH",
        "SOUTH"
      ]
    },
    "runs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "wickets": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "legalBalls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "allocatedBalls": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "targetToWin": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "freeHitPending": {
      "type": "boolean"
    },
    "ballAgeLegalBalls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "rulesId",
    "inningsIndex",
    "deliveryIndex",
    "battingTeamId",
    "bowlingTeamId",
    "strikerId",
    "nonStrikerId",
    "bowlerId",
    "keeperId",
    "outfieldIds",
    "endsBefore",
    "strikerEnd",
    "runs",
    "wickets",
    "legalBalls",
    "allocatedBalls",
    "targetToWin",
    "freeHitPending",
    "ballAgeLegalBalls"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:ScoringContext:1",
  "title": "ScoringContext"
}
