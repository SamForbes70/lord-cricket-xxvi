{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "roundNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "innings": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "battingTeamId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "runs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "wickets": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "legalBalls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "required": [
          "battingTeamId",
          "runs",
          "wickets",
          "legalBalls"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "roundNumber",
    "innings"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:SuperOverRoundSummary:1",
  "title": "SuperOverRoundSummary"
}
