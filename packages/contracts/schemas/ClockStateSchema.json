{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "localSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86399
    },
    "dayLegalBalls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "finalHourActive": {
      "type": "boolean"
    },
    "finalHourBallsRequired": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "finalHourBallsDelivered": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pendingInterval": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "LUNCH",
            "TEA",
            "STUMPS"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "day",
    "localSeconds",
    "dayLegalBalls",
    "finalHourActive",
    "finalHourBallsRequired",
    "finalHourBallsDelivered",
    "pendingInterval"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:ClockState:1",
  "title": "ClockState"
}
