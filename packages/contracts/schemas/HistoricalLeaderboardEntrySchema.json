{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tied": {
      "type": "boolean"
    },
    "playerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "teamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "RETIRED"
      ]
    },
    "qualified": {
      "type": "boolean"
    },
    "primaryDisplay": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "primaryValueX100": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "secondaryDisplay": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "denominatorCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "denominatorLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "contributingFixtureIds": {
      "minItems": 1,
      "maxItems": 2800,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    }
  },
  "required": [
    "rank",
    "tied",
    "playerId",
    "teamId",
    "status",
    "qualified",
    "primaryDisplay",
    "primaryValueX100",
    "secondaryDisplay",
    "denominatorCount",
    "denominatorLabel",
    "contributingFixtureIds"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:HistoricalLeaderboardEntry:1",
  "title": "HistoricalLeaderboardEntry"
}
