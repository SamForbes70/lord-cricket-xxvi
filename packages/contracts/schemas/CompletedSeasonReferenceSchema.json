{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seasonId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:constructor|prototype)$)[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "recordSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "seasonId",
    "recordSha256"
  ],
  "additionalProperties": false,
  "$id": "urn:lcxxvi:CompletedSeasonReference:1",
  "title": "CompletedSeasonReference"
}
